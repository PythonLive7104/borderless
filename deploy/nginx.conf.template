# Rendered by the nginx image's envsubst step (${DOMAIN} -> your domain).
# Uses Docker's embedded DNS (127.0.0.11) + variable proxy_pass so nginx
# re-resolves upstream container IPs at runtime — surviving container
# recreation without a stale-IP 502.
resolver 127.0.0.11 valid=10s ipv6=off;

# Port 80: serve the ACME (Let's Encrypt) challenge, redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# Port 443: TLS terminates here; serve the SPA and reverse-proxy the app.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    client_max_body_size 2m;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    # Reuse TLS sessions so repeat visitors skip the full handshake (~0.5s saved).
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # Empty unless ORIGIN_CLOUDFLARE_ONLY is set (deploy/originlock.sh).
    include /etc/nginx/originlock.inc;

    include /etc/nginx/security-headers.inc;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Renewal must work over HTTPS too. Behind a proxy with "Always Use HTTPS"
    # (Cloudflare's orange cloud), the ACME challenge is redirected to 443 —
    # without this it falls through to the SPA catch-all and returns index.html,
    # so the cert fails to renew silently and expires ~60 days later.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location /api/    { set $up http://backend:8000;  proxy_pass $up; include /etc/nginx/proxy.inc; }
    location /admin/  { set $up http://backend:8000;  proxy_pass $up; include /etc/nginx/proxy.inc; }
    location /static/ { set $up http://backend:8000;  proxy_pass $up; include /etc/nginx/proxy.inc; }
    location = /bl.js { set $dec http://decision:8080; proxy_pass $dec; include /etc/nginx/proxy.inc; }
    location /v1/     { set $dec http://decision:8080; proxy_pass $dec; include /etc/nginx/proxy.inc; }
    # NOTE: /l/ is deliberately NOT proxied here. Short links are served only on
    # SHORT_DOMAIN (deploy/shortdomain.sh). If a link is abused, the fallout has
    # to stay on that domain — routing redirects through the brand domain would
    # put the dashboard and email reputation behind the same blocklist entry,
    # which is the whole reason the short domain exists.

    location /assets/ {
        root /usr/share/nginx/html; expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.inc;   # add_header here drops the server-level set
    }
    # Marketing routes resolve to their own pre-rendered index.html (via $uri/).
    # Everything else (dashboard/admin/auth — not pre-rendered) falls back to the
    # blank SPA shell, NOT the landing page, so a hard refresh doesn't flash the
    # landing markup before React routes to the real page.
    location / { root /usr/share/nginx/html; index index.html; try_files $uri $uri/ /_shell.html; }
}
