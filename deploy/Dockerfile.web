# Builds the React app and serves it via nginx, which also reverse-proxies the
# API (Django) and the tracker/collect endpoints (Go engine). Build context = repo root.
FROM node:20-alpine AS build
WORKDIR /app
# Copy the lockfile too so installs are deterministic and cacheable.
COPY frontend/package.json frontend/package-lock.json ./
# Resilient install for slow/flaky networks: long per-request timeout + retries
# so a transient ETIMEDOUT to the npm registry doesn't fail the whole build.
# Falls back to `npm install` if the lockfile is ever out of sync with package.json.
RUN npm ci --no-audit --no-fund \
      --fetch-timeout=600000 --fetch-retries=5 \
      --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 \
  || npm install --no-audit --no-fund \
      --fetch-timeout=600000 --fetch-retries=5 \
      --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000
COPY frontend/ ./
# VITE_TAWK_SRC can be injected at build time; empty falls back to mailto.
ARG VITE_TAWK_SRC=""
ENV VITE_TAWK_SRC=$VITE_TAWK_SRC
RUN npm run build

FROM nginx:1.27-alpine
# 00- prefix: real_ip must be in place for every server block that follows.
COPY deploy/cloudflare-realip.conf /etc/nginx/conf.d/00-cloudflare-realip.conf
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/proxy.inc /etc/nginx/proxy.inc
COPY deploy/security-headers.inc /etc/nginx/security-headers.inc
# Optional: serve the Link Shortener on a separate short domain (SHORT_DOMAIN).
COPY deploy/shortdomain.sh /docker-entrypoint.d/30-shortdomain.sh
# Optional: refuse traffic that didn't come through Cloudflare (opt-in via
# ORIGIN_CLOUDFLARE_ONLY). Runs before shortdomain so its server blocks can
# include the result. The include must exist even when the lock is off.
COPY deploy/originlock.sh /docker-entrypoint.d/20-originlock.sh
RUN chmod +x /docker-entrypoint.d/30-shortdomain.sh /docker-entrypoint.d/20-originlock.sh \
 && touch /etc/nginx/originlock.inc
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
