# Builds the React app and serves it via nginx, which also reverse-proxies the
# API (Django) and the tracker/collect endpoints (Go engine). Build context = repo root.
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
# VITE_TAWK_SRC can be injected at build time; empty falls back to mailto.
ARG VITE_TAWK_SRC=""
ENV VITE_TAWK_SRC=$VITE_TAWK_SRC
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/proxy.inc /etc/nginx/proxy.inc
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
