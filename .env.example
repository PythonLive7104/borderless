# Public domain (used by prod compose for nginx TLS). e.g. echooconnet.com
DOMAIN=
# --- Postgres ---
POSTGRES_DB=borderless
POSTGRES_USER=borderless
POSTGRES_PASSWORD=borderless
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SECRET_KEY=nUSwDaR76SMBr-qAhCsusFq4kjHab_yxEfYtUSJYJyqFWk_nERQoRLw1zBA7chl7
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Decision service ---
DECISION_PORT=8080

TRACKER_URL=http://localhost:8080/bl.js

# Single connection string (takes precedence over POSTGRES_* above).
# In Docker use the service host "postgres"; running Django on the host use localhost:5544.
DATABASE_URL=postgresql://borderless:borderless@postgres:5432/borderless

# ============================================================
# EXTERNAL APIs — fill these in as you obtain keys.
# Everything works WITHOUT them; each key just unlocks a feature.
# (See the end of this file for where to get each one.)
# ============================================================

# --- IP intelligence (proxy / VPN / datacenter / fraud detection) ---
# Provider: none | ipqualityscore   (none = feature off, uses manual Redis sets)
IP_INTEL_PROVIDER=none
IPQUALITYSCORE_KEY=
# MaxMind (GeoIP2 / Anonymous IP) — alternative/complement
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# IPinfo — alternative geo/ASN provider
IPINFO_TOKEN=

# --- Bot-checker / threat scanning ---
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=

# --- Payments (Bachs — bachs.io) ---
# One API for cards, mobile money, crypto stablecoins (USDT/USDC) and bank
# transfer. Environment is derived from the key prefix: sk_sandbox_ vs sk_live_.
# When blank, plan upgrades activate instantly (dev stub / no charge).
# Each paid Plan must be linked to a Bachs product id (Plan.bachs_product_id).
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Bachs product id per plan (from Bachs dashboard -> Products)
BACHS_PRODUCT_STARTER=
BACHS_PRODUCT_GROWTH=
BACHS_PRODUCT_BUSINESS=

# --- Email (verification, password reset, alerts, invites) ---
# Primary method: Resend HTTP API. Set RESEND_API_KEY and email is sent live;
# leave it blank and Django prints emails to the backend console (dev).
# DEFAULT_FROM_EMAIL must use a domain you've verified in Resend
# (or onboarding@resend.dev for quick testing).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@borderless.local
FRONTEND_URL=http://localhost:5173
# Optional SMTP fallback (used only if RESEND_API_KEY is blank and EMAIL_HOST set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# ------------------------------------------------------------
# WHERE TO GET EACH KEY (we'll walk through these together):
#   IPQualityScore   -> https://www.ipqualityscore.com  (free tier: 5k/mo)
#   MaxMind GeoIP2   -> https://www.maxmind.com          (GeoLite2 is free)
#   IPinfo           -> https://ipinfo.io                 (free tier: 50k/mo)
#   Safe Browsing    -> https://developers.google.com/safe-browsing
#   VirusTotal       -> https://www.virustotal.com/gui/my-apikey
#   Bachs (payments) -> https://bachs.io  (dashboard -> Developer Portal -> API keys)
#                       docs: https://docs.bachs.io/introduction
#   Resend (email)   -> https://resend.com/api-keys  (free tier: 3k/mo)
# ------------------------------------------------------------

# Tawk.to live chat embed URL (frontend build arg)
VITE_TAWK_SRC=
