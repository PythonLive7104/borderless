POSTGRES_USER=borderless
POSTGRES_PASSWORD=borderless
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SECRET_KEY=nUSwDaR76SMBr-qAhCsusFq4kjHab_yxEfYtUSJYJyqFWk_nERQoRLw1zBA7chl7
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Decision service ---
DECISION_PORT=8080

TRACKER_URL=http://localhost:8080/bl.js

# Single connection string (takes precedence over POSTGRES_* above).
# In Docker use the service host "postgres"; running Django on the host use localhost:5544.
DATABASE_URL=postgresql://borderless:borderless@postgres:5432/borderless

# ============================================================
# EXTERNAL APIs — fill these in as you obtain keys.
# Everything works WITHOUT them; each key just unlocks a feature.
# (See the end of this file for where to get each one.)
# ============================================================

# --- IP intelligence (proxy / VPN / datacenter / fraud detection) ---
# Provider: none | ipqualityscore   (none = feature off, uses manual Redis sets)
IP_INTEL_PROVIDER=none
IPQUALITYSCORE_KEY=
# MaxMind (GeoIP2 / Anonymous IP) — alternative/complement
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# IPinfo — alternative geo/ASN provider
IPINFO_TOKEN=

# --- Destination-URL threat scanning (optional) ---
# RECOMMENDED: Google Safe Browsing — free AND allowed for commercial use.
GOOGLE_SAFE_BROWSING_KEY=
# VirusTotal — broader (70+ engines), but its FREE tier forbids commercial use
# (paid/premium is enterprise-priced). Leave blank to disable; scanning falls
# back to Safe Browsing gracefully if this key is revoked.
VIRUSTOTAL_KEY=

# --- Short-link domain & abuse handling ---
# A separate domain for short links keeps link abuse away from the reputation of
# trynobot.com (dashboard + email). Set both: SHORT_DOMAIN is what nginx serves
# (deploy/shortdomain.sh), SHORTLINK_BASE is what the dashboard shows users.
# Register it at a registrar that forwards abuse complaints instead of
# suspending the domain on the first one — Cloudflare Registrar is the safe pick.
SHORT_DOMAIN=trynb.cc
# More domains for the SHARED pool — every workspace can publish on these.
SHORT_DOMAINS=
# Served by nginx (each still needs its own certificate) but held back as stock
# to rent privately at PRIVATE_DOMAIN_PRICE/month. These never appear in a
# customer's domain picker until they rent one, and then only in theirs.
SHORT_DOMAINS_PRIVATE=korv.cc,gonb.cc

# Refuse any request that reaches the server without passing through Cloudflare.
# While the origin answers on its bare IP, anyone can ask it for the short-link
# domain and the brand domain in turn and watch the same server answer both —
# which links them however carefully the pages avoid naming each other.
# Turn on ONLY when every domain above is proxied (orange cloud) in Cloudflare;
# an unproxied domain reaches the origin directly and would go dark.
# Certificate renewal is exempt, so certbot keeps working either way.
ORIGIN_CLOUDFLARE_ONLY=0
SHORTLINK_BASE=https://trynb.cc


ABUSE_EMAIL=
ABUSE_NOTIFY_EMAIL=

# --- Payments (Bachs — bachs.io) ---
# One API for cards, mobile money, crypto stablecoins (USDT/USDC) and bank
# transfer. Environment is derived from the key prefix: sk_sandbox_ vs sk_live_.
# When blank, plan upgrades activate instantly (dev stub / no charge).
# Each paid Plan must be linked to a Bachs product id (Plan.bachs_product_id).
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Bachs product id per plan (from Bachs dashboard -> Products)
BACHS_PRODUCT_STARTER=
BACHS_PRODUCT_GROWTH=
BACHS_PRODUCT_BUSINESS=

# Monthly billing is a SEPARATE Bachs product per tier (different price), so it
# needs its own product ids. Weekly is 25/40/70; monthly is 50/100/150. Leave
# these blank until the monthly products exist in the Bachs dashboard — checkout
# then reports monthly as unavailable rather than charging the weekly price.
BACHS_PRODUCT_BASIC_MONTHLY=
BACHS_PRODUCT_PLUS_MONTHLY=
BACHS_PRODUCT_PRO_MONTHLY=

# --- Email (verification, password reset, alerts, invites) ---
# Primary method: Resend HTTP API. Set RESEND_API_KEY and email is sent live;
# leave it blank and Django prints emails to the backend console (dev).
# DEFAULT_FROM_EMAIL must use a domain you've verified in Resend
# (or onboarding@resend.dev for quick testing).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=TryNoBot <no-reply@trynobot.com>
FRONTEND_URL=http://localhost:5173
# Optional SMTP fallback (used only if RESEND_API_KEY is blank and EMAIL_HOST set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# ------------------------------------------------------------
# WHERE TO GET EACH KEY (we'll walk through these together):
#   IPQualityScore   -> https://www.ipqualityscore.com  (free tier: 5k/mo)
#   MaxMind GeoIP2   -> https://www.maxmind.com          (GeoLite2 is free)
#   IPinfo           -> https://ipinfo.io                 (free tier: 50k/mo)
#   Safe Browsing    -> https://developers.google.com/safe-browsing
#   VirusTotal       -> https://www.virustotal.com/gui/my-apikey
#   Bachs (payments) -> https://bachs.io  (dashboard -> Developer Portal -> API keys)
#                       docs: https://docs.bachs.io/introduction
#   Resend (email)   -> https://resend.com/api-keys  (free tier: 3k/mo)
# ------------------------------------------------------------

