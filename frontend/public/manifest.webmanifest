{
  "name": "TryNoBot — Traffic Intelligence",
  "short_name": "TryNoBot",
  "description": "See every visitor. Score every click. Protect every campaign.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#0a0f1d",
  "background_color": "#0a0f1d",
  "categories": ["business", "productivity", "security"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Click Log", "short_name": "Clicks", "url": "/dashboard/clicks",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Redirects", "short_name": "Links", "url": "/dashboard/links",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
